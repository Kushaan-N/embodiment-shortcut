.venv/
__pycache__/
*.pyc
data/
# Results: version the small JSON records (the measured gate values are the
# evidence the pre-registration discipline rests on); keep arrays and figures out.
results/*
!results/*/
results/*/*
!results/*/results.json
!results/*/thresholds.json
!results/*/report.json
# The pre-registration cites these as its sources, and metadata.json is the
# provenance (git sha, argv, seeds, versions) that says which run produced
# each committed record.  Small JSON; version them.
!results/*/metadata.json
!results/exp_d/floors.json
!results/power/power.json
logs/
*.npz
*.npy
*.pt
.DS_Store
